{
    "index_patterns": ["demos-aircraft-adsb*"],
    "template": {
      "settings": {
        "index": {
          "mode": "time_series",
          "default_pipeline": "demo-aircraft-adsb.opensky",
          "mapping": {
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "_source": {
          "mode": "synthetic"
        },
        "dynamic_templates": [
          {
            "strings": {
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          }
        ],
        "properties": {
          "geo_altitude": {
            "type": "float"
          },
          "icao24": {
            "time_series_dimension": true,
            "type": "keyword"
          },
          "ingest_quadrant": {
            "type": "keyword"
          },
          "latitude": {
            "type": "float"
          },
          "true_track": {
            "type": "float"
          },
          "velocity": {
            "type": "float"
          },
          "spi": {
            "type": "boolean"
          },
          "origin_country": {
            "type": "keyword"
          },
          "squawk": {
            "type": "keyword"
          },
          "baro_altitude": {
            "type": "float"
          },
          "time_position": {
            "format": "epoch_second",
            "index": true,
            "ignore_malformed": false,
            "store": false,
            "type": "date",
            "doc_values": true
          },
          "last_contact": {
            "format": "epoch_second",
            "index": true,
            "ignore_malformed": false,
            "store": false,
            "type": "date",
            "doc_values": true
          },
          "callsign": {
            "eager_global_ordinals": true,
            "norms": false,
            "null_value": "Not Assigned",
            "index": true,
            "store": false,
            "type": "keyword",
            "split_queries_on_whitespace": false,
            "index_options": "freqs",
            "doc_values": true
          },
          "location": {
            "type": "geo_point"
          },
          "on_ground": {
            "type": "boolean"
          },
          "position_source": {
            "type": "integer"
          },
          "vertical_rate": {
            "type": "float"
          },
          "longitude": {
            "type": "float"
          },
          "tags": {
            "type": "keyword"
          },
          "error": {
            "properties": {
              "enrich": {
                "properties": {
                  "country": { "type": "keyword", "ignore_above": 1024 },
                  "airport": { "type": "keyword", "ignore_above": 1024 }
                }
              }
            }
          },
          "geo": {
            "properties": {
              "ADM0_A3":    { "type": "keyword" },
              "ADMIN":      { "type": "keyword" },
              "BRK_A3":     { "type": "keyword" },
              "CONTINENT":  { "type": "keyword" },
              "ISO_A3":     { "type": "keyword" },
              "NAME":       { "type": "keyword" },
              "NAME_LONG":  { "type": "keyword" },
              "REGION_UN":  { "type": "keyword" },
              "REGION_WB":  { "type": "keyword" },
              "SOVEREIGNT": { "type": "keyword" },
              "SUBREGION":  { "type": "keyword" }
            }
          },
          "airport": {
            "properties": {
              "name":      { "type": "keyword" },
              "name_en":   { "type": "keyword" },
              "iata_code": { "type": "keyword" },
              "gps_code":  { "type": "keyword" },
              "type":      { "type": "keyword" },
              "geo": {
                "properties": {
                  "location": { "type": "geo_point" }
                }
              },
              "wikipedia": { "type": "keyword" },
              "activity":  { "type": "keyword" },
              "match_type": { "type": "keyword" }
            }
          }
        }
      },
      "lifecycle": {
        "enabled": true,
        "data_retention": "730d"
      }
    },
    "composed_of": [],
    "version": 3,
    "data_stream": {
      "hidden": false,
      "allow_custom_routing": false
    },
    "allow_auto_create": true,
    "ignore_missing_component_templates": []
  }
