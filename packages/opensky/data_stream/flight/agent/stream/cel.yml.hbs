interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.headers:
  Accept:
    - application/json
auth.oauth2:
  client.id: {{client_id}}
  client.secret: {{client_secret}}
  token_url: {{token_url}}
{{#if scopes}}
  scopes:
{{#each scopes as |scope|}}
    - {{scope}}
{{/each}}
{{/if}}
resource.url: {{url}}
state:
  initial_interval: {{initial_interval}}
  flight_scope: "{{flight_scope}}"
{{#if icao24}}
  icao24: "{{icao24}}"
{{/if}}
{{#if airport}}
  airport: "{{airport}}"
{{/if}}
program: |-
  !(
    state.flight_scope == "all" || state.flight_scope == "aircraft" || state.flight_scope == "arrival" ||
    state.flight_scope == "departure"
  ) ?
    state.with(
      {
        "events": {
          "error": {
            "code": "config",
            "id": string(state.flight_scope),
            "message": "flight_scope must be all, aircraft, arrival, or departure",
          },
        },
        "want_more": false,
      }
    )
  : (state.flight_scope == "aircraft" && string(state.?icao24.orValue("")).trim_space() == "") ?
    state.with(
      {
        "events": {
          "error": {
            "code": "config",
            "id": "icao24",
            "message": "flight_scope aircraft requires icao24",
          },
        },
        "want_more": false,
      }
    )
  : ((state.flight_scope == "arrival" || state.flight_scope == "departure") && string(state.?airport.orValue("")).trim_space() == "") ?
    state.with(
      {
        "events": {
          "error": {
            "code": "config",
            "id": "airport",
            "message": "flight_scope " + state.flight_scope + " requires airport",
          },
        },
        "want_more": false,
      }
    )
  :
    int(now).as(end,
      (
        (state.flight_scope == "aircraft") ?
          "/flights/aircraft"
        : (state.flight_scope == "arrival") ?
          "/flights/arrival"
        : (state.flight_scope == "departure") ?
          "/flights/departure"
        :
          "/flights/all"
      ).as(
        path,
        state.with(
          request(
            "GET",
            state.url.trim_right("/") + path + "?" + {
              "begin": [
                string(
                  (state.flight_scope == "all" && end - int(now - duration(state.initial_interval)) > 7200) ?
                    (end - 7200)
                  : (state.flight_scope == "aircraft" && end - int(now - duration(state.initial_interval)) > 172800) ?
                    (end - 172800)
                  : (
                    (state.flight_scope == "arrival" || state.flight_scope == "departure") &&
                    end - end % 86400 - (int(now - duration(state.initial_interval)) - int(now - duration(state.initial_interval)) % 86400) > 86400
                  ) ?
                    (end - end % 86400 - 86400)
                  :
                    int(now - duration(state.initial_interval))
                ),
              ],
              "end": [string(end)],
              ?"icao24": (state.flight_scope == "aircraft") ?
                optional.of([string(state.icao24).trim_space().to_lower()])
              :
                optional.none(),
              ?"airport": (state.flight_scope == "arrival" || state.flight_scope == "departure") ?
                optional.of([string(state.airport).trim_space()])
              :
                optional.none(),
            }.format_query()
          ).do_request().as(resp,
            (resp.StatusCode == 200 || resp.StatusCode == 404) ?
              {
                "events": (resp.StatusCode == 404) ?
                  []
                :
                  resp.Body.decode_json().map(e,
                    {
                      "message": e.with({"scope": state.flight_scope}).encode_json(),
                    }
                  ),
                "want_more": false,
              }
            :
              {
                "events": {
                  "error": {
                    "code": string(resp.StatusCode),
                    "id": string(resp.Status),
                    "message": "GET " + path + ": " + ((size(resp.Body) != 0) ? string(resp.Body) : string(resp.Status)),
                  },
                },
                "want_more": false,
              }
          )
        )
      )
    )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
