# Elastic Stack — 9.5 is the supported baseline
ELASTIC_STACK_VERSION=9.5.6

# Docker — set to . if running from this repo root
DOCKER_HOME=.

# Ingest engine:
# - "agent" (default): local standalone Elastic Agent CEL input
# - "logstash": local legacy heartbeat + HTTP filters
# - "opensky_integration": Fleet-managed OpenSky integration; no local container
# make up reads this and starts the matching local profile when applicable.
INGEST_ENGINE=agent

# Fleet-managed compatibility mode only. Set this to the concrete state-vector
# data stream created by the OpenSky integration policy namespace.
OPENSKY_INTEGRATION_DATA_STREAM=logs-opensky.state_vector-default

# Optional cluster-wide support for importing historical documents into TSDS.
# Leave false for normal live ingest. Requires a deployment that permits the
# data_stream.past_tsdb_index_creation_enabled cluster setting.
ENABLE_HISTORICAL_TSDS_IMPORT=false

# Optional DLM frozen-tier transition (for example 30d). Setup enables it only
# when an Enterprise/trial licence and snapshot repository are available.
# Leave empty for deployment-neutral retention without searchable snapshots.
DLM_FROZEN_AFTER=

# Logstash settings
LS_PIPELINE_WORKERS=2
LS_LOG_LEVEL=info
LS_MONITORING_ENABLED=false
LS_MONITORING_CLUSTER_UUID=

# Centralised Pipeline Management — set to true to fetch pipeline configs
# from Elasticsearch/Kibana instead of local files. Requires pipelines to be
# configured in Kibana > Stack Management > Logstash Pipelines.
LS_CENTRALIZED_MGMT=false

# Logstash monitoring API credentials (port 9600) — user-chosen, not issued by Elasticsearch
LS_API_USER=logstash
LS_API_PW=changeme

# Elasticsearch — endpoint URL and API key (works with Cloud Hosted, Obs Serverless, and start-local)
# The API key needs: cluster manage + manage_security, index CRUD on
# demos-*/geo.shapes-*/adsb-airports-*/logs-opensky.state_vector-*,
# and Kibana feature privileges for Saved Objects, Agent Builder, Workflows, Actions,
# Advanced Settings, Stack Alerts, Security Solution, General Cases, Main Observability,
# and Observability Cases. See README.md "Generate an API Key" for the full role descriptor.
ES_ENDPOINT=
ES_API_KEY_ID=
ES_API_KEY=
ES_API_KEY_ENCODED=

# Dedicated ingest API key (recommended). Generate it with:
#   make create-ingest-key
# Elastic Agent and Logstash use these values when set, and fall back to the
# setup key above for backwards compatibility.
ES_INGEST_API_KEY_ID=
ES_INGEST_API_KEY=

# Kibana endpoint
KB_ENDPOINT=

# Kibana space (optional) — deploy all Kibana resources into a named space.
# If set, setup.sh creates the space (Observability solution view) and
# prefixes all Kibana API paths with /s/<space>.
# Leave empty to use the default space.
KB_SPACE=

# OpenSky Network API
OPENSKY_API_USER=
OPENSKY_API_PW=
OPENSKY_API_CLIENT_ID=
OPENSKY_API_CLIENT_SECRET=

# Slack — incoming webhook URL for the daily briefing workflow (optional)
# Create a Slack app with an incoming webhook: https://api.slack.com/messaging/webhooks
# If set, setup.sh creates the Kibana Slack connector automatically.
# If not set, configure the connector manually in Kibana > Stack Management > Connectors.
SLACK_WEBHOOK_URL=

# Slack connector ID — the Kibana connector UUID used in workflow Slack steps.
# This is substituted into workflow YAML at deploy time. If SLACK_WEBHOOK_URL is
# set, setup.sh creates a connector with id d85ca362-fb82-56f6-867c-4ef2c356d912
# by default. Override here if using a different connector.
SLACK_CONNECTOR_ID=d85ca362-fb82-56f6-867c-4ef2c356d912

# GNews — API key for the news search correlation in hijack workflows (optional)
# Sign up at https://gnews.io/register for a free API key (100 req/day).
# Free tier has a 12-hour article delay; paid Essential tier is real-time.
# If not set, the workflow skips the news correlation step gracefully.
GNEWS_API_KEY=
# Stable Kibana HTTP connector ID. The API key is stored encrypted in the
# connector's secretQueryParams and is never substituted into workflow URLs.
GNEWS_CONNECTOR_ID=6e45c45d-cb6d-5e4c-a9f4-3b09b9677500

# Optional comma-separated Kibana usernames with User, Editor, or Manager access
# to the private hijack assessment agent. The automation owner retains access.
HIJACK_AGENT_ALLOWED_USERS=
HIJACK_AGENT_EDITORS=
HIJACK_AGENT_MANAGERS=

JINA_API=